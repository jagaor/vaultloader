# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
.venv/
env/
ENV/

# Variables de entorno y secretos
.env
.env.*
*.env

# Distribución / empaquetado
dist/
build/
*.egg-info/
*.egg
.eggs/

# Caché de pruebas y cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache/

# Informes generados por VaultLoader
reports/
reports/*.html
reports/*.json

# CSV de entrada: ignorar en raíz pero conservar los ejemplos
*.csv
!examples/*.csv

# IDEs y editores
.idea/
.vscode/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
